# Leave MONGODB_URI blank for the persistent local JSON demo database.
# Later paste your MongoDB Atlas connection string to use the real cloud database.
MONGODB_URI=
MONGODB_DB=house_of_farhan
# Make this a unique random string, at least 32 characters. CHANGE BEFORE DEPLOYING.
SESSION_SECRET=replace-this-with-a-long-random-secret-at-least-32-chars
# Optional: used by npm run seed to create/update the admin account.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=choose-a-strong-admin-password
